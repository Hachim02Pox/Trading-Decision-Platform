{
  "name": "gold-terminal",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:contracts": "npm run build --workspace packages/contracts",
    "dev": "npm run build:contracts && node scripts/with-session-id.js -- concurrently -n backend,frontend -c blue,magenta \"npm run dev --workspace apps/backend\" \"npm run dev --workspace apps/frontend\"",
    "typecheck": "npm run build:contracts && npm run typecheck --workspace apps/backend && npm run typecheck --workspace apps/frontend",
    "build": "npm run build:contracts && npm run build --workspace apps/backend && npm run build --workspace apps/frontend",
    "build:backend": "npm run build:contracts && npm run build --workspace apps/backend",
    "start": "node apps/backend/dist/server.js",
    "test": "tsx --env-file=apps/backend/.env --test --test-concurrency=1 tests/*.test.ts",
    "provider:test": "tsx --env-file=apps/backend/.env apps/backend/src/cli/providerTest.ts",
    "calendar:refresh": "tsx --env-file=apps/backend/.env apps/backend/src/cli/calendarRefresh.ts",
    "db:migrate": "tsx --env-file=apps/backend/.env apps/backend/src/db/migrate.ts",
    "sunday:doctor": "tsx --env-file=apps/backend/.env scripts/sundayRead.ts doctor",
    "sunday:fixture": "tsx --env-file=apps/backend/.env scripts/sundayRead.ts fixture",
    "sunday:research": "tsx --env-file=apps/backend/.env scripts/sundayRead.ts research",
    "sunday:bundle": "tsx --env-file=apps/backend/.env scripts/sundayRead.ts bundle",
    "sunday:validate": "tsx --env-file=apps/backend/.env scripts/sundayRead.ts validate",
    "night:recap": "tsx --env-file=apps/backend/.env scripts/nightRecap.ts",
    "sunday:dev": "npm run dev"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12"
  }
}
