{
  "name": "@gold-terminal/backend",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "playwright-core install chromium || echo 'playwright-core chromium install failed/skipped — F3 Fed Rate Monitor will degrade to UNAVAILABLE, see docs/PROVIDER_SETUP.md section 7a'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@gold-terminal/contracts": "^0.0.1",
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "^2.118.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "googleapis": "^161.0.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
