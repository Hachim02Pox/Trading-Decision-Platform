PORT=4001
FRONTEND_ORIGIN=http://localhost:3000

DATA_MODE=MOCK

# Gold Sunday Read — server/CLI only, never expose this in NEXT_PUBLIC_*.
PUTER_AUTH_TOKEN=
PUTER_BASE_URL=https://api.puter.com/puterai/openai/v1/chat/completions
# Puter exposes Perplexity without a Perplexity API key. The Sonar Pro
# default follows the Puter professional-research tutorial; deep-research
# remains available by changing this value.
PERPLEXITY_RESEARCH_MODEL=perplexity/sonar-deep-research
# Optional documentation-only indicator: no command is executed automatically.
ASTRA_CLI_CMD=

# Gold Sunday Read — production Drive ingestion (apps/backend/src/sundayRead/ingestion/**).
# Service-account auth: share the "Gold Sunday Read Output" Drive folder with
# GOOGLE_SERVICE_ACCOUNT_EMAIL (like sharing with a person, Viewer role) —
# no OAuth consent, no refresh token, never expires on its own.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service account JSON key's "private_key" value with real
# newlines replaced by literal \n (most .env / deployment-secret UIs require
# this) — loadGoogleDrive() unescapes it back automatically.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Shared secret required (via the X-Internal-Ingest-Secret header) by every
# internal cron-only endpoint: POST /api/internal/sunday-read/ingest AND
# POST /api/internal/calendar/ingest. Generate any long random string (e.g.
# `openssl rand -hex 32`); the SAME value must also be set as a GitHub
# Actions repo secret (INTERNAL_INGEST_SECRET) for the scheduled workflows
# to authenticate.
INTERNAL_INGEST_SECRET=

# Gold market-state (Sunday Reads V2/V3 + intermediate recaps) — unified
# pipeline, apps/backend/src/goldMarketState/**. Reuses the SAME Google Drive
# credentials as above; only the folder id can differ.
# Optional: defaults to GOOGLE_DRIVE_FOLDER_ID (the already-shared "Gold
# Sunday Read Output" folder) — set this only if the output folder is ever
# split from the legacy Sunday Read one.
GOLD_OUTPUT_FOLDER_ID=
# Optional. In-process cache TTL (seconds) for GET /api/gold/read/current and
# /history — on expiry the backend re-syncs from Drive before answering, but
# always keeps serving the last known-good published state if that re-sync
# fails. Default: 180.
GOLD_READ_CACHE_TTL_SECONDS=
# NOT read by this backend — documented here for completeness only. Google
# Drive "Gold Sunday Read Control" folder id and the stable file id of
# NEXT_GOLD_RECAP.json within it. This is ChatGPT Work's own operational
# handoff state (see GOLD_NEXT_RECAP_HANDOFF_SPEC.md) — Railway has no code
# path that reads the Control folder, and these two values must NEVER be
# granted to this backend's service account beyond what it already has,
# unless a genuinely new admin-only feature is built that needs them.
# GOLD_CONTROL_FOLDER_ID=1cfLw7eK4pnw33P_K4PIq6IgWgXgua8Ot
GOLD_NEXT_RECAP_FILE_ID=1vjvIgPV7umsbaCiuUdyxu6R980zg_dsU

# Database — apps/backend/src/db/**. This project has one DB: the same
# Supabase Postgres project Supabase Auth uses below (no separate MySQL,
# no separate DB_HOST/DB_USER/DB_NAME to set). SUPABASE_DB_PASSWORD is the
# database password from Supabase Dashboard > Project Settings > Database
# (different from the API keys below). Missing config never crashes the
# app (see config/env.ts's loadDb()); only code paths that actually touch
# the DB fail, gracefully, when it's unset.
SUPABASE_DB_PASSWORD=

# FRED — F2/F5/F7/F8/F11
FRED_API_KEY=

# BLS — F4/F5 (optional; unauthenticated single-series calls work without it)
BLS_API_KEY=

# BEA — F4 PCE
BEA_API_KEY=

# Massive (formerly Polygon.io) — F3 Fed Funds futures
MASSIVE_API_KEY=

# Tavily — research provider
TAVILY_API_KEY=
# Optional Night Recap fallback only. Used only after a 429/432 provider-limit response.
TAVILY2_API_KEY=

# Parse (parse.bot) — FinancialJuice news feed API, merged into the gold
# news feed alongside Finnhub/GDELT/Tavily (apps/backend/src/news/finnhubGoldNews.ts).
PARSE_API_KEY=

# JBlanked (jblanked.com) — legacy F13 calendar source, kept configured but
# currently UNUSED (apps/backend/src/jobs/f13CalendarIngestion.ts switched to
# the free Forex Factory feed on 2026-09-14, see providers/forexFactory.ts).
# Only needed again if JBlanked credits are purchased and the source is
# switched back.
JBLANKED_API_KEY=

# AI intelligence pilot. DATA_MODE=REAL enables only the five documented
# pilot KPIs; every other intelligence read stays explicitly mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=

# Cloud AI: KPI reads and Night Recap. Never expose these in NEXT_PUBLIC_*.
GROQ_API_KEY=
GROQ_KPI_MODEL=openai/gpt-oss-20b
GROQ_NIGHT_MODEL=openai/gpt-oss-120b
NIGHT_RECAP_CRON=
TIMEZONE=America/New_York

# Supabase Auth — holder accounts. Get these from Supabase Dashboard >
# Project Settings > API. SUPABASE_SECRET_KEY is only needed for admin-only
# backend operations, not for verifying holder sessions.
SUPABASE_API_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
