PORT=4001
FRONTEND_ORIGIN=http://localhost:3000

DATA_MODE=MOCK

# Database — apps/backend/src/db/**. This project has one DB: the same
# Supabase Postgres project Supabase Auth uses below (no separate MySQL,
# no separate DB_HOST/DB_USER/DB_NAME to set). SUPABASE_DB_PASSWORD is the
# database password from Supabase Dashboard > Project Settings > Database
# (different from the API keys below). Missing config never crashes the
# app (see config/env.ts's loadDb()); only code paths that actually touch
# the DB fail, gracefully, when it's unset.
SUPABASE_DB_PASSWORD=

# FRED — F2/F5/F7/F8/F11
FRED_API_KEY=

# BLS — F4/F5 (optional; unauthenticated single-series calls work without it)
BLS_API_KEY=

# BEA — F4 PCE
BEA_API_KEY=

# Massive (formerly Polygon.io) — F3 Fed Funds futures
MASSIVE_API_KEY=

# Tavily — research provider
TAVILY_API_KEY=

# AI intelligence pilot. DATA_MODE=REAL enables only the five documented
# pilot KPIs; every other intelligence read stays explicitly mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=

# Supabase Auth — holder accounts. Get these from Supabase Dashboard >
# Project Settings > API. SUPABASE_SECRET_KEY is only needed for admin-only
# backend operations, not for verifying holder sessions.
SUPABASE_API_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Global Read rebuild — intentionally undefined until the trader chooses the
# exact execution reference and timing policy. Empty values are surfaced in
# the report and can block exploitability; the backend does not invent them.
GLOBAL_READ_REFERENCE_SYMBOL=XAUUSD=X
GLOBAL_READ_REACTION_WINDOW_SECONDS=1800
GLOBAL_READ_MATERIALITY_PCT=
GLOBAL_READ_MAX_BAR_DISTANCE_SECONDS=300
GLOBAL_READ_EVENT_GUARD_SECONDS=54000
GLOBAL_READ_MAX_REPORT_AGE_SECONDS=
GLOBAL_READ_ACCEPT_UNOFFICIAL_REFERENCE=true
GLOBAL_READ_ADAPTIVE_LOOKBACK_SESSIONS=20
GLOBAL_READ_ADAPTIVE_PERCENTILE=80
