{
  "voice": "fr-FR-HenriNeural",
  "rate": "+0%",
  "scenes": [
    {
      "index": 1,
      "id": "intro",
      "audioFile": "scene-01.mp3",
      "durationSeconds": 33.438,
      "wordCount": 85,
      "subtitles": [
        {
          "text": "L'an dernier le café préféré de Hachim",
          "start": 0.1,
          "end": 2.388
        },
        {
          "text": "coûtait deux dollars",
          "start": 2.4,
          "end": 3.362
        },
        {
          "text": "Aujourd'hui il coûte deux dollars six",
          "start": 4.225,
          "end": 6.513
        },
        {
          "text": "Son panier de courses",
          "start": 7.375,
          "end": 8.488
        },
        {
          "text": "lui aussi a grimpé",
          "start": 8.725,
          "end": 10.0
        },
        {
          "text": "C'est ça l'inflation",
          "start": 10.863,
          "end": 12.363
        },
        {
          "text": "vue depuis la caisse du magasin",
          "start": 12.625,
          "end": 14.025
        },
        {
          "text": "Mais sur les marchés",
          "start": 14.887,
          "end": 15.838
        },
        {
          "text": "un chiffre d'inflation",
          "start": 16.163,
          "end": 17.2
        },
        {
          "text": "c'est beaucoup plus étrange",
          "start": 17.512,
          "end": 18.75
        },
        {
          "text": "Le même chiffre peut faire monter l'or",
          "start": 19.625,
          "end": 21.35
        },
        {
          "text": "ou le faire baisser",
          "start": 21.562,
          "end": 22.387
        },
        {
          "text": "Parce qu'entre l'inflation et l'or",
          "start": 23.25,
          "end": 24.738
        },
        {
          "text": "il n'y a pas un chemin.",
          "start": 25.05,
          "end": 26.012
        },
        {
          "text": "Il y en a deux",
          "start": 26.887,
          "end": 27.587
        },
        {
          "text": "qui tirent dans des sens opposés",
          "start": 27.887,
          "end": 29.3
        },
        {
          "text": "Comprendre lequel gagne",
          "start": 30.175,
          "end": 31.375
        },
        {
          "text": "c'est tout l'enjeu de F4",
          "start": 31.65,
          "end": 32.987
        }
      ]
    },
    {
      "index": 2,
      "id": "what-inflation",
      "audioFile": "scene-02.mp3",
      "durationSeconds": 62.2,
      "wordCount": 154,
      "subtitles": [
        {
          "text": "Commençons par ce que l'inflation mesure vraiment",
          "start": 0.1,
          "end": 2.35
        },
        {
          "text": "Imagine un énorme panier",
          "start": 3.212,
          "end": 4.588
        },
        {
          "text": "Du pain de l'essence",
          "start": 5.45,
          "end": 6.9
        },
        {
          "text": "un loyer un billet d'avion",
          "start": 7.138,
          "end": 8.6
        },
        {
          "text": "une coupe de cheveux",
          "start": 8.85,
          "end": 9.725
        },
        {
          "text": "Des milliers de prix",
          "start": 10.6,
          "end": 11.562
        },
        {
          "text": "Les statisticiens compressent tout ce panier en",
          "start": 12.438,
          "end": 14.512
        },
        {
          "text": "un seul nombre",
          "start": 14.525,
          "end": 15.387
        },
        {
          "text": "Un indice de prix",
          "start": 16.25,
          "end": 17.2
        },
        {
          "text": "L'inflation ce n'est pas cet indice",
          "start": 18.075,
          "end": 20.275
        },
        {
          "text": "C'est sa vitesse de variation",
          "start": 21.15,
          "end": 22.587
        },
        {
          "text": "par rapport à une date passée",
          "start": 22.913,
          "end": 24.275
        },
        {
          "text": "Et ça change tout",
          "start": 25.137,
          "end": 26.025
        },
        {
          "text": "Quand on entend que l'inflation baisse",
          "start": 26.887,
          "end": 28.55
        },
        {
          "text": "ça ne veut presque jamais dire que",
          "start": 28.825,
          "end": 30.225
        },
        {
          "text": "les prix baissent",
          "start": 30.238,
          "end": 31.05
        },
        {
          "text": "Ça veut dire qu'ils montent moins vite",
          "start": 31.925,
          "end": 33.65
        },
        {
          "text": "Ça c'est la désinflation",
          "start": 34.513,
          "end": 36.062
        },
        {
          "text": "Pour que les prix baissent vraiment",
          "start": 36.938,
          "end": 38.188
        },
        {
          "text": "il faut que l'indice lui-même recule",
          "start": 38.487,
          "end": 40.025
        },
        {
          "text": "durablement Ça c'est la déflation",
          "start": 40.312,
          "end": 43.237
        },
        {
          "text": "Rien à voir",
          "start": 44.112,
          "end": 44.975
        },
        {
          "text": "Ces chiffres servent à tout le monde",
          "start": 45.85,
          "end": 47.487
        },
        {
          "text": "Aux ménages aux entreprises pour les salaires",
          "start": 48.35,
          "end": 50.562
        },
        {
          "text": "et les contrats",
          "start": 50.575,
          "end": 51.15
        },
        {
          "text": "aux gouvernements à la banque centrale",
          "start": 51.438,
          "end": 53.188
        },
        {
          "text": "et aux investisseurs",
          "start": 53.475,
          "end": 54.5
        },
        {
          "text": "Mais aucun indice n'est exactement ton coût",
          "start": 55.375,
          "end": 57.237
        },
        {
          "text": "de la vie",
          "start": 57.25,
          "end": 57.725
        },
        {
          "text": "Ton panier ta ville",
          "start": 58.587,
          "end": 59.875
        },
        {
          "text": "tes habitudes sont uniques",
          "start": 60.175,
          "end": 61.75
        }
      ]
    },
    {
      "index": 3,
      "id": "core-cpi",
      "audioFile": "scene-03.mp3",
      "durationSeconds": 60.975,
      "wordCount": 165,
      "subtitles": [
        {
          "text": "Le chiffre le plus célèbre",
          "start": 0.1,
          "end": 1.387
        },
        {
          "text": "c'est le CPI",
          "start": 1.663,
          "end": 2.375
        },
        {
          "text": "l'indice des prix à la consommation américain",
          "start": 2.737,
          "end": 4.825
        },
        {
          "text": "Il est construit par le bureau des",
          "start": 5.7,
          "end": 7.0
        },
        {
          "text": "statistiques du travail",
          "start": 7.013,
          "end": 8.175
        },
        {
          "text": "à partir de prix relevés sur un",
          "start": 8.438,
          "end": 9.725
        },
        {
          "text": "panier de consommation",
          "start": 9.738,
          "end": 10.825
        },
        {
          "text": "et de poids qui reflètent ce que",
          "start": 11.175,
          "end": 12.375
        },
        {
          "text": "les ménages dépensent",
          "start": 12.387,
          "end": 13.475
        },
        {
          "text": "Le CPI global prend tout le panier",
          "start": 14.35,
          "end": 16.337
        },
        {
          "text": "Le CPI sous-jacent",
          "start": 17.212,
          "end": 18.387
        },
        {
          "text": "lui retire l'alimentation et l'énergie",
          "start": 18.688,
          "end": 20.913
        },
        {
          "text": "Pourquoi Parce que ces prix sautent dans",
          "start": 21.775,
          "end": 24.288
        },
        {
          "text": "tous les sens d'un mois à l'autre",
          "start": 24.3,
          "end": 25.562
        },
        {
          "text": "et cachent la tendance de fond",
          "start": 25.9,
          "end": 27.163
        },
        {
          "text": "Attention Les retirer ne veut pas dire",
          "start": 28.038,
          "end": 30.775
        },
        {
          "text": "qu'ils ne comptent pas.",
          "start": 30.788,
          "end": 31.625
        },
        {
          "text": "Et le sous-jacent n'est pas une prévision",
          "start": 32.5,
          "end": 34.275
        },
        {
          "text": "À l'intérieur chaque morceau vit à son",
          "start": 35.15,
          "end": 37.337
        },
        {
          "text": "propre rythme Le logement bouge lentement",
          "start": 37.35,
          "end": 40.275
        },
        {
          "text": "parce que les loyers entrent avec retard",
          "start": 40.587,
          "end": 42.312
        },
        {
          "text": "Les voitures d'occasion peuvent se retourner brutalement",
          "start": 43.175,
          "end": 45.625
        },
        {
          "text": "Les services médicaux suivent leur propre horloge",
          "start": 46.487,
          "end": 48.8
        },
        {
          "text": "Deux chiffres sous-jacents identiques peuvent donc cacher",
          "start": 49.675,
          "end": 51.987
        },
        {
          "text": "des persistances très différentes",
          "start": 52.0,
          "end": 53.65
        },
        {
          "text": "Et les chiffres sont corrigés des saisons",
          "start": 54.525,
          "end": 56.212
        },
        {
          "text": "pour comparer un mois à l'autre",
          "start": 56.538,
          "end": 57.8
        },
        {
          "text": "une correction qui peut elle-même être révisée",
          "start": 58.013,
          "end": 59.862
        },
        {
          "text": "plus tard",
          "start": 59.875,
          "end": 60.525
        }
      ]
    },
    {
      "index": 4,
      "id": "mom-yoy",
      "audioFile": "scene-04.mp3",
      "durationSeconds": 80.663,
      "wordCount": 183,
      "subtitles": [
        {
          "text": "Un même indice donne deux lectures",
          "start": 0.1,
          "end": 1.7
        },
        {
          "text": "Sur un mois",
          "start": 2.562,
          "end": 3.2
        },
        {
          "text": "on compare avec le mois précédent",
          "start": 3.5,
          "end": 4.987
        },
        {
          "text": "Sur un an",
          "start": 5.85,
          "end": 6.438
        },
        {
          "text": "on compare avec le même mois",
          "start": 6.688,
          "end": 7.888
        },
        {
          "text": "un an plus tôt",
          "start": 8.2,
          "end": 8.912
        },
        {
          "text": "Exemple L'indice passe de 310 à 310,93",
          "start": 9.775,
          "end": 14.7
        },
        {
          "text": "Sur un mois",
          "start": 15.575,
          "end": 16.2
        },
        {
          "text": "ça fait plus 0,30  pourcent",
          "start": 16.525,
          "end": 18.45
        },
        {
          "text": "Un an plus tôt",
          "start": 19.325,
          "end": 20.125
        },
        {
          "text": "il valait 301,6",
          "start": 20.413,
          "end": 21.962
        },
        {
          "text": "Sur un an",
          "start": 22.825,
          "end": 23.4
        },
        {
          "text": "ça fait environ 3,09  pourcent",
          "start": 23.738,
          "end": 25.95
        },
        {
          "text": "Maintenant le piège",
          "start": 26.825,
          "end": 28.288
        },
        {
          "text": "L'effet de base",
          "start": 29.163,
          "end": 30.15
        },
        {
          "text": "Imagine que l'inflation sur un an soit",
          "start": 31.025,
          "end": 32.712
        },
        {
          "text": "la somme des douze derniers mois",
          "start": 32.725,
          "end": 34.025
        },
        {
          "text": "dans une fenêtre qui avance",
          "start": 34.337,
          "end": 35.862
        },
        {
          "text": "Ce mois-ci le sous-jacent fait 0,35  pourcent",
          "start": 36.737,
          "end": 39.925
        },
        {
          "text": "sur un mois",
          "start": 39.938,
          "end": 40.45
        },
        {
          "text": "après 0,20  le mois d'avant",
          "start": 40.788,
          "end": 42.475
        },
        {
          "text": "Ça accélère Et pourtant",
          "start": 43.35,
          "end": 45.737
        },
        {
          "text": "sur un an",
          "start": 46.05,
          "end": 46.525
        },
        {
          "text": "l'inflation recule de 3,2  à 3,1  pourcent",
          "start": 46.862,
          "end": 50.225
        },
        {
          "text": "Pourquoi Parce qu'un vieux mois très fort",
          "start": 51.1,
          "end": 53.825
        },
        {
          "text": "à 0,45 vient de sortir de la",
          "start": 54.087,
          "end": 56.55
        },
        {
          "text": "fenêtre Le nouveau 0,35  remplace un ancien",
          "start": 56.562,
          "end": 60.388
        },
        {
          "text": "0,45 Aucun des deux chiffres n'est faux",
          "start": 60.4,
          "end": 64.037
        },
        {
          "text": "Ils regardent des horizons différents",
          "start": 64.912,
          "end": 66.562
        },
        {
          "text": "Le bon mot pour ce genre de",
          "start": 67.438,
          "end": 68.7
        },
        {
          "text": "publication contrastée Et les marchés",
          "start": 68.713,
          "end": 71.85
        },
        {
          "text": "eux réagissent surtout à la surprise par",
          "start": 72.175,
          "end": 74.175
        },
        {
          "text": "rapport au consensus",
          "start": 74.188,
          "end": 75.338
        },
        {
          "text": "et aux détails qui comptent pour la",
          "start": 75.612,
          "end": 76.763
        },
        {
          "text": "banque centrale Pas juste au sens du",
          "start": 76.775,
          "end": 79.4
        },
        {
          "text": "chiffre sur un an",
          "start": 79.412,
          "end": 80.213
        }
      ]
    },
    {
      "index": 5,
      "id": "pce-vs-cpi",
      "audioFile": "scene-05.mp3",
      "durationSeconds": 57.9,
      "wordCount": 151,
      "subtitles": [
        {
          "text": "Il existe un autre grand indice",
          "start": 0.1,
          "end": 1.9
        },
        {
          "text": "Le PCE l'indice des dépenses de consommation",
          "start": 2.775,
          "end": 5.5
        },
        {
          "text": "Il est construit par le bureau d'analyse",
          "start": 6.375,
          "end": 8.025
        },
        {
          "text": "économique à partir de données d'entreprises et",
          "start": 8.037,
          "end": 10.3
        },
        {
          "text": "d'administrations Il couvre un univers plus large",
          "start": 10.312,
          "end": 13.575
        },
        {
          "text": "y compris certaines dépenses payées pour le",
          "start": 13.912,
          "end": 15.65
        },
        {
          "text": "compte des ménages",
          "start": 15.662,
          "end": 16.512
        },
        {
          "text": "comme une partie de la santé",
          "start": 16.788,
          "end": 18.087
        },
        {
          "text": "Et il est pondéré en chaîne",
          "start": 18.95,
          "end": 20.275
        },
        {
          "text": "Concrètement Imaginons que le prix du bœuf",
          "start": 21.15,
          "end": 24.062
        },
        {
          "text": "flambe Hachim passe au poulet",
          "start": 24.075,
          "end": 26.512
        },
        {
          "text": "Le PCE capte mieux ce genre de",
          "start": 27.387,
          "end": 29.05
        },
        {
          "text": "changement d'habitude Le CPI",
          "start": 29.062,
          "end": 31.625
        },
        {
          "text": "lui suit plutôt un panier payé directement",
          "start": 31.962,
          "end": 34.237
        },
        {
          "text": "par les ménages",
          "start": 34.25,
          "end": 34.962
        },
        {
          "text": "avec d'autres poids et d'autres formules",
          "start": 35.3,
          "end": 37.062
        },
        {
          "text": "Et voici le détail qui compte",
          "start": 37.925,
          "end": 39.55
        },
        {
          "text": "L'objectif de 2 pourcent de la banque",
          "start": 40.425,
          "end": 42.175
        },
        {
          "text": "centrale américaine est défini sur le PCE",
          "start": 42.188,
          "end": 44.2
        },
        {
          "text": "global Le PCE sous-jacent est très surveillé",
          "start": 44.212,
          "end": 47.487
        },
        {
          "text": "pour la tendance de fond",
          "start": 47.5,
          "end": 48.55
        },
        {
          "text": "Le CPI sort plus tôt dans le",
          "start": 49.425,
          "end": 50.85
        },
        {
          "text": "mois et oriente ce qu'on attend du",
          "start": 50.862,
          "end": 52.55
        },
        {
          "text": "PCE Les deux se complètent",
          "start": 52.562,
          "end": 55.112
        },
        {
          "text": "Ils ne sont pas interchangeables",
          "start": 55.987,
          "end": 57.45
        }
      ]
    },
    {
      "index": 6,
      "id": "ppi",
      "audioFile": "scene-06.mp3",
      "durationSeconds": 41.525,
      "wordCount": 105,
      "subtitles": [
        {
          "text": "Remontons maintenant la chaîne de production",
          "start": 0.1,
          "end": 2.112
        },
        {
          "text": "Le PPI mesure les prix de vente",
          "start": 2.987,
          "end": 4.513
        },
        {
          "text": "des producteurs américains",
          "start": 4.525,
          "end": 5.75
        },
        {
          "text": "pour les biens",
          "start": 6.037,
          "end": 6.6
        },
        {
          "text": "les services et la construction destinés à",
          "start": 6.925,
          "end": 8.775
        },
        {
          "text": "la demande finale",
          "start": 8.787,
          "end": 9.7
        },
        {
          "text": "C'est l'amont L'usine",
          "start": 10.562,
          "end": 12.575
        },
        {
          "text": "avant le magasin",
          "start": 12.9,
          "end": 13.787
        },
        {
          "text": "Quand les coûts montent chez les producteurs",
          "start": 14.662,
          "end": 16.212
        },
        {
          "text": "trois choses peuvent arriver",
          "start": 16.5,
          "end": 17.675
        },
        {
          "text": "Soit ils rognent sur leurs marges",
          "start": 18.538,
          "end": 19.975
        },
        {
          "text": "Soit des gains de productivité compensent",
          "start": 20.85,
          "end": 22.95
        },
        {
          "text": "Soit ils répercutent la hausse sur le",
          "start": 23.825,
          "end": 25.312
        },
        {
          "text": "consommateur avec un décalage",
          "start": 25.325,
          "end": 27.288
        },
        {
          "text": "Certaines catégories du PPI servent même à",
          "start": 28.163,
          "end": 30.238
        },
        {
          "text": "estimer des morceaux du PCE",
          "start": 30.25,
          "end": 31.712
        },
        {
          "text": "Donc le détail du PPI est utile",
          "start": 32.587,
          "end": 34.6
        },
        {
          "text": "Mais le chiffre global du PPI",
          "start": 35.462,
          "end": 37.1
        },
        {
          "text": "tout seul ne prédit mécaniquement ni le",
          "start": 37.425,
          "end": 39.525
        },
        {
          "text": "CPI ni le PCE",
          "start": 39.538,
          "end": 41.075
        }
      ]
    },
    {
      "index": 7,
      "id": "annualized",
      "audioFile": "scene-07.mp3",
      "durationSeconds": 48.463,
      "wordCount": 133,
      "subtitles": [
        {
          "text": "Pour voir la tendance récente",
          "start": 0.1,
          "end": 1.488
        },
        {
          "text": "on utilise souvent un taux annualisé sur",
          "start": 1.8,
          "end": 3.475
        },
        {
          "text": "trois mois L'idée",
          "start": 3.487,
          "end": 5.35
        },
        {
          "text": "prendre la variation des trois derniers mois",
          "start": 5.575,
          "end": 7.338
        },
        {
          "text": "et se demander ce que ça donnerait",
          "start": 7.675,
          "end": 8.975
        },
        {
          "text": "si ce rythme durait un an entier",
          "start": 8.988,
          "end": 10.525
        },
        {
          "text": "La vraie formule",
          "start": 11.387,
          "end": 12.25
        },
        {
          "text": "c'est l'indice récent",
          "start": 12.562,
          "end": 13.438
        },
        {
          "text": "divisé par l'indice d'il y a trois",
          "start": 13.7,
          "end": 15.15
        },
        {
          "text": "mois le tout puissance quatre",
          "start": 15.162,
          "end": 16.788
        },
        {
          "text": "moins un Ce n'est pas additionner les",
          "start": 17.075,
          "end": 19.475
        },
        {
          "text": "trois derniers mois et multiplier par quatre",
          "start": 19.488,
          "end": 21.525
        },
        {
