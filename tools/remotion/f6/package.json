{
  "name": "f6-education-video",
  "version": "0.0.0",
  "private": true,
  "description": "Remotion project for the F6 (USD / Change) educational video.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts F6Video out/f6-dollar.mp4",
    "poster": "remotion still src/index.ts F6Video out/f6-dollar-poster.jpg --frame=95",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.286",
    "@remotion/cli": "4.0.286"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
