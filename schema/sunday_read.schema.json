{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gold-terminal.local/schema/sunday_read.schema.json",
  "title": "Gold Sunday Read",
  "type": "object",
  "additionalProperties": true,
  "required": ["meta", "executive_narrative", "contexts", "priced_in", "scenario_tree", "scenario_explanations", "asymmetry", "catalysts", "invalidations", "contradictions", "anomalies", "unknowns", "weekly_timeline", "evidence", "sources"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "executive_narrative": { "type": "string" },
    "what_changed_this_week": { "$ref": "#/$defs/stringArray" },
    "qualitative_confidence": { "enum": ["CLEAR", "LIKELY", "PLAUSIBLE", "MIXED", "INSUFFICIENT_EVIDENCE", "UNKNOWN"] },
    "competing_hypotheses": { "type": "array", "items": { "$ref": "#/$defs/hypothesis" } },
    "cross_asset_reality_test": { "$ref": "#/$defs/crossAssetRealityTest" },
    "dominant_driver": { "type": "string" },
    "transmission_chains": { "$ref": "#/$defs/stringArray" },
    "late": { "$ref": "#/$defs/late" },
    "event_expiry": { "$ref": "#/$defs/eventExpiry" },
    "contexts": { "$ref": "#/$defs/contexts" },
    "priced_in": { "$ref": "#/$defs/pricedIn" },
    "scenario_tree": { "$ref": "#/$defs/scenarioTree" },
    "scenario_explanations": { "type": "array", "items": { "$ref": "#/$defs/scenarioExplanation" } },
    "asymmetry": { "$ref": "#/$defs/asymmetry" },
    "catalysts": { "type": "array", "items": { "$ref": "#/$defs/catalyst" } },
    "invalidations": { "$ref": "#/$defs/stringArray" },
    "contradictions": { "$ref": "#/$defs/stringArray" },
    "anomalies": { "$ref": "#/$defs/stringArray" },
    "unknowns": { "$ref": "#/$defs/stringArray" },
    "weekly_timeline": { "type": "array", "items": { "$ref": "#/$defs/timeline" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "glossary": { "type": "array", "items": { "$ref": "#/$defs/glossaryEntry" } },
    "presentation": { "$ref": "#/$defs/presentation" }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "nullableString": { "type": ["string", "null"] },
    "meta": { "type": "object", "required": ["run_id", "week_of", "generated_at", "data_mode", "status"], "properties": { "run_id": { "type": "string" }, "week_of": { "type": "string" }, "generated_at": { "type": "string" }, "data_mode": { "enum": ["FIXTURE", "REAL"] }, "status": { "enum": ["COMPLETE", "PARTIAL"] }, "as_of": { "type": "string" }, "gold_price_change": { "type": "string" } } },
    "source": { "type": "object", "required": ["source_id", "title", "publisher", "author", "published_at", "url", "ultimate_origin", "syndication_notes", "retrieved_at", "provider"], "properties": { "source_id": { "type": "string" }, "title": { "type": "string" }, "publisher": { "$ref": "#/$defs/nullableString" }, "author": { "$ref": "#/$defs/nullableString" }, "published_at": { "$ref": "#/$defs/nullableString" }, "url": { "type": "string", "format": "uri" }, "ultimate_origin": { "$ref": "#/$defs/nullableString" }, "syndication_notes": { "$ref": "#/$defs/nullableString" }, "retrieved_at": { "type": "string" }, "provider": { "type": "string" } } },
    "evidence": { "type": "object", "required": ["id", "family", "owner", "statement", "value", "unit", "as_of", "measurement_window", "status", "type", "epistemic_status", "change_status", "source_refs", "reported_link_type", "notes"], "properties": { "id": { "type": "string" }, "family": { "enum": ["weekly_recap", "family_1_fed", "family_2_rates", "family_3_usd", "family_4_macro", "family_5_flows", "family_6_structural"] }, "owner": { "type": "string" }, "statement": { "type": "string" }, "value": { "type": ["string", "number", "null"] }, "unit": { "$ref": "#/$defs/nullableString" }, "as_of": { "$ref": "#/$defs/nullableString" }, "measurement_window": { "$ref": "#/$defs/nullableString" }, "status": { "enum": ["ANSWERED", "PARTIAL", "UNKNOWN"] }, "type": { "enum": ["EVENT_FACT", "STATE", "REPORTED_LINK"] }, "epistemic_status": { "enum": ["OBSERVED", "DECLARED", "PUBLISHED", "ESTIMATED", "INFERRED", "CALCULATED", "QUALITATIVE", "UNKNOWN"] }, "change_status": { "type": "string" }, "source_refs": { "$ref": "#/$defs/stringArray" }, "reported_link_type": { "enum": ["REACTION_TO_EVENT", "ANTICIPATION_AHEAD_OF_EVENT", "OTHER", "UNCLEAR"] }, "notes": { "type": "string" } } },
    "hypothesis": { "type": "object", "required": ["id", "thesis", "evidence_for", "evidence_against", "status"], "properties": { "id": { "type": "string" }, "thesis": { "type": "string" }, "evidence_for": { "$ref": "#/$defs/stringArray" }, "evidence_against": { "$ref": "#/$defs/stringArray" }, "status": { "type": "string" } } },
    "crossAssetRealityTest": { "type": "object", "required": ["summary", "matching_hypothesis_ids", "conflicting_observations"], "properties": { "summary": { "type": "string" }, "matching_hypothesis_ids": { "$ref": "#/$defs/stringArray" }, "conflicting_observations": { "$ref": "#/$defs/stringArray" } } },
    "late": { "type": "object", "required": ["status", "reason"], "properties": { "status": { "enum": ["EARLY", "BALANCED", "CROWDED", "LATE", "UNKNOWN"] }, "reason": { "type": "string" } } },
    "eventExpiry": { "type": "object", "required": ["expires_at", "reason"], "properties": { "expires_at": { "$ref": "#/$defs/nullableString" }, "reason": { "$ref": "#/$defs/nullableString" } } },
    "context": { "type": "object", "required": ["orientation", "why", "evidence_refs", "competing_thesis", "invalidation"], "properties": { "orientation": { "enum": ["BULLISH", "BEARISH", "MIXED", "UNCLEAR"] }, "why": { "type": "string" }, "evidence_refs": { "$ref": "#/$defs/stringArray" }, "competing_thesis": { "type": "string" }, "invalidation": { "type": "string" } } },
    "contexts": { "type": "object", "required": ["tactical", "medium", "structural"], "properties": { "tactical": { "$ref": "#/$defs/context" }, "medium": { "$ref": "#/$defs/context" }, "structural": { "$ref": "#/$defs/context" } } },
    "pricedIn": { "type": "object", "required": ["already_priced", "surprise_candidates", "status"], "properties": { "already_priced": { "$ref": "#/$defs/stringArray" }, "surprise_candidates": { "type": "array", "items": { "type": "object", "required": ["baseline", "surprise_condition", "first_channel", "branch_refs"], "properties": { "baseline": { "type": "string" }, "surprise_condition": { "type": "string" }, "first_channel": { "type": "string" }, "branch_refs": { "$ref": "#/$defs/stringArray" } } } }, "status": { "enum": ["KNOWN", "PARTIAL", "UNKNOWN"] } } },
    "scenarioNode": { "type": "object", "required": ["id", "label", "description", "type", "status", "evidence_refs"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "description": { "type": "string" }, "type": { "enum": ["FACT", "STATE", "DRIVER", "TRANSMISSION", "CATALYST", "CONDITION", "POSITIONING", "FUNDING", "OPTIONS", "ASYMMETRY_GATE", "TERMINAL"] }, "status": { "enum": ["CONFIRMED", "WATCH", "PENDING", "UNKNOWN", "CONTRADICTED"] }, "evidence_refs": { "$ref": "#/$defs/stringArray" }, "terminal_outcome": { "enum": ["BULLISH", "BEARISH", "NO_EDGE", "UNRESOLVED"] }, "primary_value": { "type": "string" }, "as_of": { "type": "string" }, "measurement_window": { "type": "string" }, "family_refs": { "type": "array", "items": { "enum": ["weekly_recap", "family_1_fed", "family_2_rates", "family_3_usd", "family_4_macro", "family_5_flows", "family_6_structural"] } }, "owner": { "type": "string" }, "change": { "type": "string" }, "role_in_story": { "type": "string" }, "contradictions": { "$ref": "#/$defs/stringArray" }, "trigger_condition": { "type": "string" }, "evidence_gap": { "type": "string" } } },
    "scenarioTree": { "type": "object", "required": ["nodes", "edges"], "properties": { "nodes": { "type": "array", "items": { "$ref": "#/$defs/scenarioNode" } }, "edges": { "type": "array", "items": { "type": "object", "required": ["from", "to"], "properties": { "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" }, "status": { "enum": ["CONFIRMED", "WATCH", "PENDING", "UNKNOWN", "CONTRADICTED"] } } } } } },
    "scenarioExplanation": { "type": "object", "required": ["id", "title", "summary", "meaning", "waits_for", "invalidations", "branch_node_ids"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "summary": { "type": "string" }, "meaning": { "type": "string" }, "waits_for": { "$ref": "#/$defs/stringArray" }, "invalidations": { "$ref": "#/$defs/stringArray" }, "branch_node_ids": { "$ref": "#/$defs/stringArray" } } },
    "asymmetry": { "type": "object", "required": ["summary", "opportunity", "edge"], "properties": { "summary": { "type": "string" }, "opportunity": { "enum": ["EARLY", "BALANCED", "CROWDED", "LATE", "UNKNOWN"] }, "edge": { "enum": ["BULLISH", "BEARISH", "NO_EDGE", "UNKNOWN"] } } },
    "catalyst": { "type": "object", "required": ["event", "date_time", "expectation", "question", "branch_refs", "tier"], "properties": { "event": { "type": "string" }, "date_time": { "$ref": "#/$defs/nullableString" }, "expectation": { "type": "string" }, "question": { "type": "string" }, "branch_refs": { "$ref": "#/$defs/stringArray" }, "tier": { "enum": ["TIER_1", "TIER_2"] } } },
    "timeline": { "type": "object", "required": ["date", "price_fact", "events", "cross_asset_move", "reported_attribution"], "properties": { "date": { "type": "string" }, "price_fact": { "type": "string" }, "events": { "$ref": "#/$defs/stringArray" }, "cross_asset_move": { "type": "string" }, "reported_attribution": { "type": "string" } } },
    "localizedGlossaryEntry": {
      "type": "object",
      "required": ["term", "short_definition", "why_it_matters", "context_here"],
      "properties": {
        "term": { "type": "string" },
        "short_definition": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "context_here": { "type": "string" }
      },
      "additionalProperties": true
    },
    "glossaryEntry": {
      "type": "object",
      "required": ["id", "fr", "en"],
      "properties": {
        "id": { "type": "string" },
        "fr": { "$ref": "#/$defs/localizedGlossaryEntry" },
        "en": { "$ref": "#/$defs/localizedGlossaryEntry" }
      },
      "additionalProperties": true
    },
    "presentationScope": {
      "type": "object",
      "required": ["reviewed_week_start", "reviewed_week_end", "upcoming_week_start", "upcoming_week_end"],
      "properties": {
        "reviewed_week_start": { "type": "string" },
        "reviewed_week_end": { "type": "string" },
        "upcoming_week_start": { "type": "string" },
        "upcoming_week_end": { "type": "string" }
      },
      "additionalProperties": true
    },
    "marketStoryPresentation": {
      "type": "object",
      "required": ["past_week", "current_setup", "week_ahead"],
      "properties": {
        "past_week": { "type": "string" },
        "current_setup": { "type": "string" },
        "week_ahead": { "type": "string" }
      },
      "additionalProperties": true
    },
    "horizonPresentation": {
      "type": "object",
      "required": ["summary", "supporting_points", "counter_case", "invalidation_explained"],
      "properties": {
        "summary": { "type": "string" },
        "supporting_points": { "type": "array", "items": { "type": "string" } },
        "counter_case": { "type": "string" },
        "invalidation_explained": { "type": "string" }
      },
      "additionalProperties": true
    },
    "surprisePresentation": {
      "type": "object",
      "required": ["title", "baseline_explained", "surprise_explained", "transmission_explained", "gold_confirmation"],
      "properties": {
        "title": { "type": "string" },
        "baseline_explained": { "type": "string" },
        "surprise_explained": { "type": "string" },
        "transmission_explained": { "type": "string" },
        "gold_confirmation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "pricedInPresentation": {
      "type": "object",
      "required": ["already_priced", "surprises"],
      "properties": {
        "already_priced": { "type": "array", "items": { "type": "string" } },
        "surprises": { "type": "array", "items": { "$ref": "#/$defs/surprisePresentation" } }
      },
      "additionalProperties": true
    },
    "localizedScenarioNodeCopy": {
      "type": "object",
      "required": ["node_id", "label", "description"],
      "properties": {
        "node_id": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "localizedScenarioEdgeCopy": {
      "type": "object",
      "required": ["edge_id", "label", "explanation"],
      "properties": {
        "edge_id": { "type": "string" },
        "label": { "type": "string" },
        "explanation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scenarioTreeLocalization": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/localizedScenarioNodeCopy" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/localizedScenarioEdgeCopy" } }
      },
      "additionalProperties": true
    },
    "walkthroughStep": {
      "type": "object",
      "required": ["id", "node_refs", "edge_refs", "text"],
      "properties": {
        "id": { "type": "string" },
        "node_refs": { "$ref": "#/$defs/stringArray" },
        "edge_refs": { "$ref": "#/$defs/stringArray" },
        "text": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scenarioWalkthrough": {
      "type": "object",
      "required": ["intro", "steps"],
      "properties": {
        "intro": { "type": "string" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/walkthroughStep" } }
      },
      "additionalProperties": true
    },
    "asymmetryPresentation": {
      "type": "object",
      "required": ["headline", "summary", "why", "what_would_change_it"],
      "properties": {
        "headline": { "type": "string" },
        "summary": { "type": "string" },
        "why": { "type": "string" },
        "what_would_change_it": { "type": "string" }
      },
      "additionalProperties": true
    },
    "localePresentation": {
      "type": "object",
      "required": ["title", "subtitle"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "market_story": { "$ref": "#/$defs/marketStoryPresentation" },
        "horizons": {
          "type": "object",
          "properties": {
            "tactical": { "$ref": "#/$defs/horizonPresentation" },
            "medium": { "$ref": "#/$defs/horizonPresentation" },
            "structural": { "$ref": "#/$defs/horizonPresentation" }
          }
        },
        "priced_in": { "$ref": "#/$defs/pricedInPresentation" },
        "asymmetry": { "$ref": "#/$defs/asymmetryPresentation" },
        "scenario_tree": { "$ref": "#/$defs/scenarioTreeLocalization" },
        "walkthrough": { "$ref": "#/$defs/scenarioWalkthrough" }
      },
      "additionalProperties": true
    },
    "presentation": {
      "type": "object",
      "required": ["version", "scope", "fr", "en"],
      "properties": {
        "version": { "type": "integer", "enum": [2] },
        "scope": { "$ref": "#/$defs/presentationScope" },
        "fr": { "$ref": "#/$defs/localePresentation" },
        "en": { "$ref": "#/$defs/localePresentation" }
      },
      "additionalProperties": true
    }
  }
}
